# --- NextAuth / Auth.js ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github  (dev)
#               https://your-domain.com/api/auth/callback/github (prod)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Admin ---
# Your GitHub username - only this account can access /admin
ADMIN_GITHUB_USERNAME=notoxus

# --- GitHub Sync (Observer pattern) ---
# Personal Access Token with: repo (read/write), issues (write)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Your repo details (for pushing MDX files + creating comment Issues)
GITHUB_OWNER=notoxus
GITHUB_REPO=portfolio-website

# --- Existing (keep as-is) ---
GROQ_API_KEY=
